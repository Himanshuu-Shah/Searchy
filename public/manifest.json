{
  "manifest_version": 3,
  "name": "Searchy",
  "description": "An enhanced Find in Page browser extension.",
  "version": "0.1.0",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}